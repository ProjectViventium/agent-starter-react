# Viventium call page: every variable the page's server reads. Names and placeholders only;
# in a Viventium install the launcher supplies the real values. Never commit a filled-in copy.

# --- LiveKit (required) ---
# Address the page's server uses, and the default address handed to a local browser.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: browser-facing local address when it differs from LIVEKIT_URL.
NEXT_PUBLIC_LIVEKIT_URL=
# Optional: LiveKit server API host for room and agent-dispatch calls (default: LIVEKIT_URL).
LIVEKIT_API_HOST=

# --- Viventium Core (required for signed calls; set both or neither) ---
VIVENTIUM_LIBRECHAT_ORIGIN=
VIVENTIUM_CALL_SESSION_SECRET=
# Optional: timeout in ms for requests to Core (default 4500).
VIVENTIUM_CALL_PROXY_TIMEOUT_MS=

# --- Voice worker dispatch (optional) ---
# Budget in ms to attach one voice worker before the token is minted (default 2500, 250-5000).
VIVENTIUM_CALL_DISPATCH_ASSIGN_TIMEOUT_MS=
# "token_room_config" puts the agent in the token instead of an explicit dispatch (default: explicit).
VIVENTIUM_LIVEKIT_AGENT_DISPATCH_MODE=

# --- Voice gateway (provider catalog for the voice picker) ---
VOICE_GATEWAY_HOST=127.0.0.1
# Port of the gateway health server (VOICE_GATEWAY_PORT is read as a fallback).
VIVENTIUM_VOICE_GATEWAY_HEALTH_PORT=8000

# --- Calls from a phone on the LAN or through the public tunnel (optional) ---
VIVENTIUM_PUBLIC_PLAYGROUND_URL=
VIVENTIUM_PUBLIC_LIVEKIT_URL=
VIVENTIUM_LAN_PLAYGROUND_URL=
VIVENTIUM_LAN_LIVEKIT_URL=
VIVENTIUM_LAN_DOMAIN=
# Launcher-written JSON with the current public and LAN addresses; when set it is their only source.
VIVENTIUM_PUBLIC_NETWORK_STATE_FILE=
# Extra hostnames allowed to load dev-server resources.
VIVENTIUM_PUBLIC_CLIENT_URL=
VIVENTIUM_PUBLIC_SERVER_URL=

# --- Build and dev server (optional) ---
# 40-character commit of this build, reported by GET /api/health as source_ref.
VIVENTIUM_PLAYGROUND_BUILD_REF=
# Relative build output folder, so several dev servers can run from one checkout.
VIVENTIUM_PLAYGROUND_NEXT_DIST_DIR=

# --- Development only ---
# 1 allows a token without a Viventium call session (fresh random room, nothing from the caller).
VIVENTIUM_ALLOW_DIRECT_AGENT_DISPATCH=
# Agent name for unsigned development calls (signed calls take the agent from Core).
AGENT_NAME=
